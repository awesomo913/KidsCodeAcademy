{
  "id": 28,
  "title": "Check Your Work",
  "goal": "Did it really work? Click. Test. Try again. THEN say done.",
  "sticker_emoji": "✅",
  "mascot_lines": [
    "Saying 'done' too early makes builders sad.",
    "First we CHECK. Click everything. Try the buttons.",
    "Only THEN we say done.",
    "Put the steps in order."
  ],
  "game": {
    "type": "sequence-the-steps",
    "payload": {
      "prompt": "Put the 'check your work' steps in order:",
      "steps": [
        "Make the change",
        "Click and try it",
        "Notice if it broke",
        "Say done"
      ]
    }
  },
  "hints": {
    "tier1": {
      "highlight": "order"
    },
    "tier2": {
      "rephrase": "You make it, you try it, you see if it broke, THEN you say done."
    },
    "tier3": {
      "nudge": "The last step is bragging. Before that you must test it!"
    }
  },
