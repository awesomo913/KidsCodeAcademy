      "highlight": "touch"
    },
    "tier2": {
      "rephrase": "Pick the fix that makes the flag fire only on touch."
    },
    "tier3": {
      "nudge": "The flag needs proper hitbox-on-hitbox checking — not just 'walked past'."
    }
  },
  "sandbox": {
    "helpers": [
      "claude"
