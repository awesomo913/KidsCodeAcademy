      "side_effect": { "action": "draw_svg", "shape": "star", "color": "gold" },
      "options": ["Yes, draw more!", "I'm all done!"],
      "branches": { "Yes, draw more!": "t3", "I'm all done!": "t4" }
    },
    "t2_heart": {
      "bot_lines": ["A heart, just for you!", "Want another shape?"],
      "side_effect": { "action": "draw_svg", "shape": "heart", "color": "#ff5a78" },
      "options": ["Yes, draw more!", "I'm all done!"],
      "branches": { "Yes, draw more!": "t3", "I'm all done!": "t4" }
    },
    "t2_rainbow": {
      "bot_lines": ["A rainbow with every color!", "Want another shape?"],
      "side_effect": { "action": "draw_svg", "shape": "rainbow", "color": "gold" },
      "options": ["Yes, draw more!", "I'm all done!"],
      "branches": { "Yes, draw more!": "t3", "I'm all done!": "t4" }
    },
    "t2_circle": {
      "bot_lines": ["A round circle!", "Want another shape?"],
      "side_effect": { "action": "draw_svg", "shape": "circle", "color": "#ffb84d" },
      "options": ["Yes, draw more!", "I'm all done!"],
      "branches": { "Yes, draw more!": "t3", "I'm all done!": "t4" }
    },
    "t3": {
      "bot_lines": ["Pick another! I love drawing."],
      "options": ["A triangle", "A square", "A surprise!"],
      "branches": { "A triangle": "t3_triangle", "A square": "t3_square", "A surprise!": "t3_surprise" },
      "fallback_turn": "t3"
    },
    "t3_triangle": {
      "bot_lines": ["Three sides — a triangle!", "Great job picking!"],
      "side_effect": { "action": "draw_svg", "shape": "triangle", "color": "#6b8cff" },
      "options": ["Cool!"],
      "branches": { "Cool!": "t4" }
    },
    "t3_square": {
      "bot_lines": ["A square box, ta-da!"],
      "side_effect": { "action": "draw_svg", "shape": "square", "color": "#5acf95" },
      "options": ["Cool!"],
      "branches": { "Cool!": "t4" }
    },
    "t3_surprise": {
      "bot_lines": ["Surprise! Have a star and a rainbow.", "Two shapes for the price of one!"],
      "side_effect": { "action": "draw_svg", "shape": "star", "color": "#ff5a78" },
      "options": ["So cool!"],
      "branches": { "So cool!": "t4" }
    },
    "t4": {
      "bot_lines": ["You did it! You asked an AI to make art for you.", "That's exactly how real artists use AI helpers!"],
      "side_effect": { "action": "show_thinking", "steps": ["You asked", "I drew it", "You loved it!"], "duration_ms": 1800 }
    }
  }
