{
  "helper": "claude",
  "lesson_id": 2,
  "mode": "turns",
  "start_turn": "t1",
  "auto_complete": true,
  "fallback": "Pick a shape, or try saying 'star' or 'heart'!",
  "matches": [
    { "keywords": ["star"],     "typing_delay_ms": 700, "reply_lines": ["A shiny star coming up!"],      "side_effect": { "action": "draw_svg", "shape": "star",     "color": "gold" } },
    { "keywords": ["heart"],    "typing_delay_ms": 700, "reply_lines": ["A heart, just for you!"],       "side_effect": { "action": "draw_svg", "shape": "heart",    "color": "#ff5a78" } },
    { "keywords": ["rainbow"],  "typing_delay_ms": 800, "reply_lines": ["A rainbow with all the colors!"], "side_effect": { "action": "draw_svg", "shape": "rainbow",  "color": "gold" } },
    { "keywords": ["circle"],   "typing_delay_ms": 700, "reply_lines": ["A round circle!"],              "side_effect": { "action": "draw_svg", "shape": "circle",   "color": "#ffb84d" } },
    { "keywords": ["hi","hello"], "typing_delay_ms": 600, "reply_lines": ["Hi! Pick a shape and I will draw it!"], "side_effect": null }
  ],
  "turns": {
    "t1": {
      "bot_lines": ["Hi! I'm Claude. I can draw shapes for you.", "Which one should I make first?"],
      "options": ["A star", "A heart", "A rainbow", "A circle"],
