{
  "helper": "claude",
  "lesson_id": 11,
  "mode": "turns",
  "start_turn": "t1",
  "auto_complete": true,
  "fallback": "Try 'plan a story', 'help me think', or 'three steps'!",
  "matches": [
    { "keywords": ["plan","story"], "typing_delay_ms": 900, "reply_lines": ["Sure! Pick a hero, find a problem, write the ending. Want help with step 1?"], "side_effect": { "action": "show_thinking", "steps": ["I read the question", "I make a plan", "I write step 1"], "duration_ms": 1800 } },
    { "keywords": ["hi","hello"], "typing_delay_ms": 600, "reply_lines": ["Hi! I'm Claude. Want me to plan something with you?"], "side_effect": null }
  ],
  "turns": {
    "t1": {
      "bot_lines": ["I'm Claude. I'm really good at breaking big ideas into small steps.", "What big thing do you want to plan?"],
      "options": ["Make a video game", "Write a story", "Build a website", "Build a plan with chips!"],
      "branches": {
        "Make a video game": "t2_game",
        "Write a story": "t2_story",
        "Build a website": "t2_site",
        "Build a plan with chips!": "t_pb"
      },
      "fallback_turn": "t1"
    },
    "t_pb": {
      "bot_lines": ["Awesome! Pick one chip from each row.", "This is exactly how I plan in my head — what to do, who for, and how big!"],
      "prompt_builder": true,
      "builder_cols": {
        "verb":   { "label": "What to do",   "chips": ["Plan", "Design", "Sketch"] },
        "what":   { "label": "What",          "chips": ["a birthday", "a school project", "a treasure hunt"] },
        "scope":  { "label": "How big",       "chips": ["in 3 steps", "for one day", "for the whole class"] }
      },
      "next_turn": "t_pb_done"
    },
    "t_pb_done": {
      "bot_lines": ["Perfect prompt!", "I'd start by listing 3 small steps. Each step gets you closer.", "That's how every big plan works — small steps, one at a time."],
      "side_effect": { "action": "show_thinking", "steps": ["Read your prompt", "Pick 3 small steps", "Show you the plan"], "duration_ms": 2000 }
    },
    "t2_game": {
      "bot_lines": ["A video game! Awesome.", "Every game needs three things. Can you guess one?"],
      "options": ["A goal to win", "A player or hero", "Rules"],
      "branches": { "A goal to win": "t3_game", "A player or hero": "t3_game", "Rules": "t3_game" },
      "fallback_turn": "t2_game"
    },
    "t2_story": {
      "bot_lines": ["Stories rock!", "Great stories have a hero with a problem.", "Who is YOUR hero?"],
      "options": ["A kid like me", "A robot", "A talking animal"],
      "branches": { "A kid like me": "t3_story", "A robot": "t3_story", "A talking animal": "t3_story" },
      "fallback_turn": "t2_story"
    },
    "t2_site": {
      "bot_lines": ["Websites show information to people.", "What is your website about?"],
      "options": ["My pets", "Favorite games", "Cool space facts"],
      "branches": { "My pets": "t3_site", "Favorite games": "t3_site", "Cool space facts": "t3_site" },
      "fallback_turn": "t2_site"
    },
    "t3_game": {
      "bot_lines": ["Nice pick!", "Here is your three-step plan to start your game."],
      "side_effect": { "action": "show_thinking", "steps": ["1. Pick the goal", "2. Draw the hero", "3. Write the rules"], "duration_ms": 2200 },
      "options": ["Show me step 1", "Show me step 2", "Show me step 3"],
      "branches": { "Show me step 1": "t4_step1", "Show me step 2": "t4_step2", "Show me step 3": "t4_step3" },
      "fallback_turn": "t3_game"
    },
    "t3_story": {
      "bot_lines": ["Great hero!", "Here is your three-step plan to start your story."],
      "side_effect": { "action": "show_thinking", "steps": ["1. Meet the hero", "2. Find the problem", "3. Write the ending"], "duration_ms": 2200 },
      "options": ["Show me step 1", "Show me step 2", "Show me step 3"],
      "branches": { "Show me step 1": "t4_step1", "Show me step 2": "t4_step2", "Show me step 3": "t4_step3" },
      "fallback_turn": "t3_story"
    },
    "t3_site": {
      "bot_lines": ["Cool topic!", "Here is a three-step plan for your website."],
      "side_effect": { "action": "show_thinking", "steps": ["1. Pick a title", "2. Write 3 facts", "3. Add one picture"], "duration_ms": 2200 },
      "options": ["Show me step 1", "Show me step 2", "Show me step 3"],
      "branches": { "Show me step 1": "t4_step1", "Show me step 2": "t4_step2", "Show me step 3": "t4_step3" },
      "fallback_turn": "t3_site"
    },
    "t4_step1": {
      "bot_lines": ["Step 1: Start small. Pick just ONE thing first.", "Don't try to do everything at once. That is how plans work!"],
      "options": ["Got it!"],
      "branches": { "Got it!": "t5" }
    },
    "t4_step2": {
      "bot_lines": ["Step 2: Once step 1 is done, build on top of it.", "Each step gets easier because you already did the last one."],
      "options": ["Got it!"],
      "branches": { "Got it!": "t5" }
    },
    "t4_step3": {
      "bot_lines": ["Step 3: Finish strong! The last step is the most fun.", "When you finish, you can show people what you made."],
      "options": ["Got it!"],
      "branches": { "Got it!": "t5" }
    },
    "t5": {
      "bot_lines": ["You just made a real plan with an AI!", "This is how coders start every big project — break it into tiny steps."],
      "side_effect": { "action": "show_thinking", "steps": ["Big idea", "Three steps", "Start step one!"], "duration_ms": 1800 }
    }
  }
}
